# 로그 회전 — /etc/logrotate.d/alphaloop 로 복사해 쓴다 (10-ops 10.10)
#   sudo cp /opt/alphaloop/ops/deploy/alphaloop.logrotate /etc/logrotate.d/alphaloop
# copytruncate를 쓰는 이유: cron이 append로 열어둔 파일을 옮기지 않고 그 자리에서 비운다.
/var/log/alphaloop/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
